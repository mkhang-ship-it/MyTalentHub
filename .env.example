# Biến môi trường backend FTalentHub — copy thành .env khi cần đổi mặc định.
# Mọi biến đều có giá trị mặc định trong code, thiếu file này app vẫn chạy.

# CORS: origin frontend cho phép, phân tách dấu phẩy. Không bao giờ để "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hạn access token (phút) — hết hạn thì dùng refresh token đổi, không cần đăng nhập lại.
ACCESS_TOKEN_TTL_MINUTES=60
# Hạn refresh token (ngày).
REFRESH_TOKEN_TTL_DAYS=30
# Tương thích ngược: hạn token cũ khi không đặt ACCESS_TOKEN_TTL_MINUTES.
TOKEN_TTL_DAYS=7

# Đăng ký công khai: "true" cho dev/demo; production đặt "false" để chặn
# POST /auth/register (trả 403 kèm thông điệp tiếng Việt).
ALLOW_PUBLIC_REGISTER=true

# Vòng băm PBKDF2-SHA256 cho mật khẩu. Đổi giá trị không làm vỡ hash cũ
# vì số vòng được lưu cùng hash.
PBKDF2_ITERATIONS=240000

# Mức log uvicorn.
LOG_LEVEL=INFO

# CSDL: bỏ trống = SQLite backend/talenthub.db. Sang PostgreSQL thì đặt URL
# SQLAlchemy, ví dụ postgresql+psycopg://user:pass@db:5432/ftalenthub
# (lưu ý: phải pip install "psycopg[binary]" thêm vì chưa có trong requirements).
# DATABASE_URL=

# URL frontend thật — dùng để dựng link trong mail xác minh/quên mật khẩu.
FRONTEND_URL=http://127.0.0.1:5174

# SMTP gửi mail thật. Bỏ trống = chế độ outbox (ghi thư ra backend/outbox/,
# chỉ dùng dev/test). Production BẮT BUỘC đặt SMTP + MAIL_TO_OUTBOX=false,
# nếu không link đặt lại mật khẩu rò rỉ cho bất kỳ ai đọc được đĩa/log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@ftalenthub.edu.vn
MAIL_TO_OUTBOX=true

# Hạn link xác minh email (phút) và đặt lại mật khẩu (phút).
VERIFY_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30

# Bỏ qua bắt xác minh email: "true" cho dev/CI; production cân nhắc "false".
ALLOW_UNVERIFIED_EMAIL=true

# Email liên hệ hiển thị trong app.
CONTACT_EMAIL=bgh@ftalenthub.edu.vn

# Key AI (optional — không đặt thì tính năng gợi ý AI tắt).
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
